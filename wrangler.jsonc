{
  // Cloudflare settings. LEAGUE_ID changes every season (see CLAUDE.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drafty-in-here",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so www.draftyinhere.com can be
    // redirected before the page loads (it then hands pages to ASSETS).
    "run_worker_first": true
  },
  "vars": {
    "LEAGUE_ID": "634",
    "DEFAULT_ENTRY_ID": "1412",
    "CLASSIC_LEAGUE_ID": "2757"
  },
  // KV (binding LAST_GOOD) is optional and not set up yet: auto-provisioning
  // broke the Workers Builds preview build. Add it back with an explicit
  // namespace id once one exists. See docs/setup.md.
  // draftyinhere.com is registered in the same Cloudflare account. Deploys
  // keep both names attached; www redirects to the bare name (worker/index.ts).
  // The old workers.dev address keeps working too.
  "routes": [
    { "pattern": "draftyinhere.com", "custom_domain": true },
    { "pattern": "www.draftyinhere.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
