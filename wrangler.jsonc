{
  // Cloudflare settings. LEAGUE_ID changes every season (see CLAUDE.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drafty-in-here",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LEAGUE_ID": "634",
    "DEFAULT_ENTRY_ID": "1412"
  },
  // No id: Wrangler creates the namespace on first deploy. If it can't, the
  // site still works (see worker/index.ts), it just can't keep finished
  // gameweeks between restarts.
  "kv_namespaces": [{ "binding": "LAST_GOOD" }],
  "observability": { "enabled": true }
}
